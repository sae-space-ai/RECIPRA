{
  "name": "recipra",
  "version": "0.1.0",
  "private": true,
  "description": "RECIPRA — Reward OS Platform. Proprietary, modular, multi-tenant, event-driven.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @recipra/web build",
    "build:api": "pnpm --filter @recipra/api build",
    "build:worker": "pnpm --filter @recipra/worker build",
    "build:admin": "pnpm --filter @recipra/admin build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:db": "pnpm --filter @recipra/database test",
    "dev": "pnpm -r --parallel dev",
    "db:migrate": "pnpm --filter @recipra/database migrate",
    "db:seed": "pnpm --filter @recipra/database seed",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
