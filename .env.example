# RECIPRA Environment Configuration
# NEVER commit real secrets. Use environment variables in production.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/recipra
DATABASE_READ_URL=postgresql://readonly:password@localhost:5432/recipra

# Redis
REDIS_URL=redis://localhost:6379

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Session
SESSION_SECRET=change-me-in-production-min-32-chars
SESSION_MAX_AGE=86400

# OAuth (adapters - replace with real credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=

# Payment Provider (Sandbox first, then real)
PSP_PROVIDER=sandbox
PSP_API_KEY=
PSP_WEBHOOK_SECRET=

# AI Provider (adapters - replace with real credentials)
AI_PROVIDER=sandbox
AI_API_KEY=

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=recipra

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Feature Flags
ENABLE_AI_MODULES=false
ENABLE_MARKETPLACE=false
ENABLE_PRO_MODULES=false

# Tenant (for development)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
